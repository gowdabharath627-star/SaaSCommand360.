{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 1. Run FastAPI Backend (Port 8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "⚙️ 2. Run Warehouse Medallion Pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/warehouse/pipeline.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🤖 3. Train ML Churn Model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ml/churn_model.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🔔 4. Evaluate Decision Engine Rules",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/decision_engine/rules.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🧪 5. Run Pytest Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["backend/tests/test_api.py", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
