# ========================================================
# SaaSCommand 360 — Environment Configuration
# ========================================================

# 1. DATABASE_URL:
# Option A: Neon Serverless Postgres (Cloud Free Tier):
# Copy your connection string directly from Neon Console (https://console.neon.tech):
# DATABASE_URL=postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Local PostgreSQL & pgAdmin:
# DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/saascommand360

# Option C: Leave blank for zero-setup local SQLite & DuckDB
DATABASE_URL=

# 2. Application Ports & Configuration
API_PORT=8000
FRONTEND_PORT=5173
SECRET_KEY=saascommand360_capstone_secure_secret_key_2026
ENVIRONMENT=development
